# Copia este archivo como lan.env en el PC central. No lo subas a Git.
HOST=0.0.0.0
PORT=3081
# IP o nombre del PC central y puerto exactos. Sin http ni rutas.
ALLOWED_HOSTS=192.168.1.50:3081
AUTH_USERNAME=finanzas
# Obligatorio: elige 16 a 128 caracteres ASCII sin espacios.
AUTH_PASSWORD=
# Certificado valido para la IP/nombre anterior, confiable en tus PC.
TLS_KEY_PATH=certs/server-key.pem
TLS_CERT_PATH=certs/server-cert.pem
# Omite DATABASE_PATH para conservar data/finanzas.sqlite de esta instalacion.
